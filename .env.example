# LegalProof AI Environment Configuration
# ---------------------------------------------------------

# The secret key used to sign JSON Web Tokens (JWT)
JWT_SECRET=""

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# The PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/legalproof_db?schema=public
DATABASE_URL=""

# OR use explicit connection variables (e.g. for Google Cloud SQL)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_PORT="5432"

# ---------------------------------------------------------
# POLYGON AMOY BLOCKCHAIN CONFIGURATION
# ---------------------------------------------------------
# Polygon Amoy RPC Endpoint (e.g. https://rpc-amoy.polygon.technology/ or Alchemy/Infura URL)
BLOCKCHAIN_RPC_URL=""

# Private key of the wallet funded with Polygon Amoy testnet MATIC
BLOCKCHAIN_PRIVATE_KEY=""

# Deployed LegalProofEvidenceRegistry contract address on Polygon Amoy
BLOCKCHAIN_CONTRACT_ADDRESS=""

# ---------------------------------------------------------
# INFRASTRUCTURE (Auto-injected by AI Studio)
# ---------------------------------------------------------
# The Gemini API Key required for AI analysis
GEMINI_API_KEY=""

# The base URL where this applet is hosted
APP_URL=""

# ---------------------------------------------------------
# PERSISTENT OBJECT STORAGE (Google Cloud Storage)
# ---------------------------------------------------------
# Google Cloud Storage bucket name for persistent evidence file storage
# If empty, the server automatically falls back to local /uploads storage.
EVIDENCE_STORAGE_BUCKET=""
