# Application Environment & URLs
NODE_ENV=production
APP_BASE_URL=https://your-production-domain.run.app
ALLOWED_ORIGINS=

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Authentication Secrets
JWT_SECRET=

# Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LegalProof AI" <notifications@your-domain.com>

# Server-Side AI (Google Gemini)
GEMINI_API_KEY=

# Blockchain Configuration (Polygon Amoy)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# Cloud Object Storage (Supabase Storage - Primary Production Vault)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence-vault

# Cloud Object Storage (Google Cloud Storage - Alternative Backend)
EVIDENCE_STORAGE_BUCKET=

# Initial Administrator Provisioning (Optional Script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
